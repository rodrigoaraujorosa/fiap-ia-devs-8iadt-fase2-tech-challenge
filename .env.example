# Nível de log do Algoritmo Genético.
# INFO  → registra eventos relevantes (início/fim, seleção, cruzamentos e
#          mutações que ocorreram, estatísticas por geração).
# DEBUG → registra, adicionalmente, todos os indivíduos da população,
#          slots selecionados no torneio e operações que NÃO ocorreram.
GA_LOG_LEVEL=INFO
# OpenAI API key for LLM medical interpretation (required for diagnosis_app.py)
OPENAI_API_KEY=
